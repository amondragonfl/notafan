{
  "manifest_version": 3,
  "name": "notafan",
  "version": "0.1.0",
  "description": "Records your Instagram followers and following as you scroll through them.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage"],

  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["shared/browser.js", "content/instagram.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "notafan",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "notafan@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
